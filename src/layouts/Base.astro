---
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const { title, lang = 'en' } = Astro.props;

const L = {
  en: {
    brand: 'Provost Ultrasound Lab',
    defaultTitle: 'Provost Ultrasound Lab',
    nav: { home: 'Home', research: 'Research', people: 'People', publications: 'Publications', codes: 'Codes', videos: 'Videos', join: 'Join our Team' },
    toggleLabel: 'Français',
    footer: 'Provost Ultrasound Lab · Polytechnique Montréal',
  },
  fr: {
    brand: "Laboratoire d'ultrasons Provost",
    defaultTitle: "Laboratoire d'ultrasons Provost",
    nav: { home: 'Accueil', research: 'Recherche', people: 'Membres', publications: 'Publications', codes: 'Codes', videos: 'Vidéos', join: "Rejoignez notre équipe" },
    toggleLabel: 'English',
    footer: "Laboratoire d'ultrasons Provost · Polytechnique Montréal",
  },
};
const t = L[lang];
const resolvedTitle = title || t.defaultTitle;

// Build nav paths with /fr/ prefix when on French
const p = lang === 'fr' ? 'fr/' : '';
const nav = [
  { href: p,                       label: t.nav.home },
  { href: p + 'research',          label: t.nav.research },
  { href: p + 'people',            label: t.nav.people },
  { href: p + 'publications',      label: t.nav.publications },
  { href: p + 'publications/codes',  label: t.nav.codes },
  { href: p + 'publications/videos', label: t.nav.videos },
  { href: p + 'join',              label: t.nav.join },
];

const link = (h) => (h ? `${base}${h}` : base);
const here = Astro.url.pathname.replace(/\/$/, '');
const isActive = (h) => here === link(h).replace(/\/$/, '');

// Smart language toggle — mirror the current path in the other language
const baseNoSlash = base.replace(/\/$/, '');
let pathTail = here.startsWith(baseNoSlash) ? here.slice(baseNoSlash.length) : here;
pathTail = pathTail.replace(/^\/+/, '');
// Strip the fr/ prefix if present
let mirrorTail = pathTail;
if (mirrorTail.startsWith('fr/')) mirrorTail = mirrorTail.slice(3);
else if (mirrorTail === 'fr') mirrorTail = '';
const toggleHref = lang === 'fr' ? mirrorTail : ('fr/' + mirrorTail).replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={link(p)} aria-label={t.brand}>
        <img src={`${base}lab-logo.png`} alt={t.brand} />
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
      <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </label>
      <nav class="site-nav">
        {nav.map((item) => (
          <a
            href={link(item.href)}
            class={isActive(item.href) ? 'active' : ''}
          >
            {item.label}
          </a>
        ))}
        <a class="lang-toggle" href={link(toggleHref)}>{t.toggleLabel}</a>
        <a href={link(p + 'tetris')} target="_blank" rel="noopener">Tetris</a>
        <a href={link(p + 'ulmaga')} target="_blank" rel="noopener">ULMaga</a>
      </nav>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>{t.footer}</p>
    </footer>

    <style is:global>
      :root {
        --accent: #00477b;
        --accent-dark: #002f54;
        --ink: #1d2733;
        --muted: #5f6b7a;
        --line: #e3e8ef;
        --maxw: 960px;
        --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      img, iframe, video { max-width: 100%; }
      body {
        margin: 0;
        font-family: var(--font);
        -webkit-font-smoothing: antialiased;
        color: var(--ink);
        line-height: 1.6;
        background: #fff;
      }
      a { color: var(--accent); }
      .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 24px;
        border-bottom: 1px solid var(--line);
        max-width: var(--maxw);
        margin: 0 auto;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .brand img {
        display: block;
        height: 44px;
        width: auto;
      }
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        font-size: 14px;
      }
      .site-nav a {
        text-decoration: none;
        color: var(--muted);
      }
      .site-nav a:hover { color: var(--accent); }
      .site-nav a.active { color: var(--accent); font-weight: 600; }
      .site-nav .lang-toggle {
        color: var(--accent);
        font-weight: 600;
        border-left: 1px solid var(--line);
        padding-left: 16px;
        margin-left: 0;
      }
      /* Mobile hamburger — hidden on desktop */
      .nav-burger { display: none; }
      .nav-burger span {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--ink);
        border-radius: 2px;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .content {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 32px 24px 64px;
      }
      .content h1 { font-size: 30px; margin-top: 0; color: var(--accent-dark); letter-spacing: -0.01em; }
      .content h2 { font-size: 20px; margin-top: 36px; }
      .site-footer {
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 13px;
        text-align: center;
        padding: 24px;
      }

      @media (max-width: 720px) {
        .site-header {
          flex-wrap: wrap;
          padding: 14px 18px;
        }
        .nav-burger {
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 5px;
          width: 44px;
          height: 44px;
          margin: -10px;
          cursor: pointer;
        }
        /* Animate burger into an X when open */
        .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
          transform: translateY(7px) rotate(45deg);
        }
        .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
        .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
          transform: translateY(-7px) rotate(-45deg);
        }
        .site-nav {
          order: 3;
          flex-basis: 100%;
          flex-direction: column;
          gap: 0;
          font-size: 16px;
          display: none;
        }
        .nav-toggle:checked ~ .site-nav { display: flex; }
        .site-nav a {
          padding: 12px 2px;
          border-bottom: 1px solid var(--line);
        }
        .site-nav .lang-toggle {
          border-left: none;
          padding-left: 2px;
        }
        .content {
          padding: 24px 18px 48px;
        }
        .content h1 { font-size: 25px; }
        .content h2 { font-size: 19px; }
      }
    </style>
  </body>
</html>
