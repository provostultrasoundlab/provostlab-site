---
import Base from '../../layouts/Base.astro';

const videos = [
  {
    src: 'https://streams.bitmovin.com/crm59bpblhh42vu610g0/embed',
    caption: 'Webinar by Prof. Jean Provost, sponsored by Verasonics and published on Sept 10, 2024',
  },
  {
    src: 'https://www.youtube.com/embed/5VxaoK36mCQ',
    caption: 'Introductory video on ultrasound localization microscopy (Chloé Bourquin, Ph.D., in French)',
  },
];
---
<Base title="Videos — Provost Ultrasound Lab">
  <h1>Webinars and Videos</h1>

  <div class="video-grid">
    {videos.map((v) => (
      <figure class="video-card">
        <div class="embed">
          <iframe
            src={v.src}
            title={v.caption}
            loading="lazy"
            allow="autoplay; encrypted-media; fullscreen"
            allowfullscreen
          ></iframe>
        </div>
        <figcaption>{v.caption}</figcaption>
      </figure>
    ))}
  </div>

  <style>
    h1 {
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 28px;
      margin-bottom: 0;
    }
    h1::after {
      content: '';
      display: block;
      width: 60%;
      max-width: 280px;
      height: 3px;
      background: var(--accent);
      margin: 8px auto 0;
    }
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 32px;
      margin-top: 32px;
    }
    .video-card { margin: 0; }
    .embed {
      position: relative;
      aspect-ratio: 16 / 9;
      width: 100%;
    }
    .embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 10px;
    }
    figcaption {
      margin-top: 10px;
      font-size: 14px;
      color: var(--muted);
      line-height: 1.5;
    }
  </style>
</Base>
