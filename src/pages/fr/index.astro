---
<Base lang="fr">
  <h1>Laboratoire d'ultrasons Provost</h1>

  {news.map((e, index) => (
    <article class="news">
      {e.headshot && (
        <img
          class="byline-avatar"
          src={img(e.headshot)}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          width="64"
          height="64"
        />
      )}
      {e.headshots && (
        <div class="byline-avatars">
          {e.headshots.map((h) => (
            <img
              class="byline-avatar"
              src={img(h)}
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              width="64"
              height="64"
            />
          ))}
        </div>
      )}
      <div class="news-date">{e.date}</div>
      <h2 class="news-title">{e.title}</h2>
      {e.images && (
        <div class="news-media">
          {e.images.map((n) => (
            <img
              src={img(n)}
              alt={e.title}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              width="520"
              height="292"
            />
          ))}
        </div>
      )}
      {e.clip && (
        <div class="news-media">
          <video
            class="news-clip"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            poster={`${base}${e.clip.poster}`}
            width="520"
            height="390"
          >
            <source src={`${base}${e.clip.webm}`} type="video/webm" />
            <source src={`${base}${e.clip.mp4}`} type="video/mp4" />
          </video>
        </div>
      )}
      {e.video && (
        <div class="embed">
          <iframe
            src={e.video.type === 'youtube'
              ? `https://www.youtube.com/embed/${e.video.id}`
              : `https://drive.google.com/file/d/${e.video.id}/preview`}
            title={e.title}
            loading="lazy"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        </div>
      )}
      {e.body.map((p) => <p>{p}</p>)}
      {e.program && (
        <ul class="news-program">
          {e.program.map((t) => (
            <li>
              <div class="program-when"><strong>{t.kind}</strong> · {t.when} · {t.room}</div>
              <div class="program-title">{t.title}</div>
              <div class="program-authors">{t.authors}</div>
              <div class="program-note">{t.note}</div>
            </li>
          ))}
        </ul>
      )}
      {e.links && (
        <ul class="news-links">
          {e.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      )}
    </article>
  ))}

  <style>
    .news { padding: 26px 0; border-bottom: 1px solid var(--line); }
    .news:last-child { border-bottom: none; }
    .news-date { font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
    .news-title { font-size: 19px; margin: 4px 0 12px; color: var(--accent-dark); border: none; padding: 0; }
    .news-media { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
    .news-media img, .news-media video { width: 100%; max-width: 520px; height: auto; border-radius: 10px; display: block; }
    .byline-avatar { float: right; width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin: 6px 0 10px 14px; }
    .byline-avatars { float: right; display: flex; gap: 8px; margin: 6px 0 10px 14px; }
    .byline-avatars .byline-avatar { float: none; margin: 0; }
    .embed { position: relative; aspect-ratio: 16 / 9; max-width: 560px; margin-bottom: 14px; }
    .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 10px; }
    .news p { margin: 0 0 10px; }
    .news-links { margin: 8px 0 0; padding-left: 18px; }
    .news-links li { margin: 2px 0; }
    .news-links a { font-size: 14px; }
    .news-program { list-style: none; margin: 14px 0 0; padding: 0; }
    .news-program li { margin: 0 0 14px; padding-left: 12px; border-left: 3px solid var(--line); }
    .program-when { font-size: 13px; color: var(--muted); }
    .program-when strong { color: var(--accent); }
    .program-title { font-weight: 600; margin: 2px 0; }
    .program-authors, .program-note { font-size: 14px; }
    .program-note { color: var(--muted); }
  </style>
</Base>
