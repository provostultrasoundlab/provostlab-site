---
import Base from '../../layouts/Base.astro';
import yamlText from '../../data/publications.yaml?raw';
import yaml from 'js-yaml';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const publications = yaml.load(yamlText);

const linkify = (s) =>
  s.replace(/(https?:\/\/[^\s<>"]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');
---
<Base lang="fr" title="Publications — Laboratoire d'ultrasons Provost">
  <h1>Publications</h1>

  <h2>Articles évalués par les pairs et prépublications</h2>
  <p>
    Pour une liste complète, voir la
    <a href="https://scholar.google.com/citations?user=3ga4SSoAAAAJ&hl=en" target="_blank" rel="noopener">page Google Scholar de J. Provost</a>.
    Presque toutes nos publications évaluées par les pairs sont également disponibles sous forme de prépublications sur des serveurs publics ainsi que sur ce site :
  </p>

  {publications.map((group) => (
    <section class="year-section">
      <h3 class="year-header">{group.year === 'Upcoming' ? 'À venir' : group.year}</h3>
      {group.items.map((it) => (
        <article class="pub">
          <a class="pub-title" href={it.pdf ? `${base}${it.pdf}` : it.url} target="_blank" rel="noopener">{it.title}</a>
          <p class="pub-cite" set:html={linkify(it.citation)} />
        </article>
      ))}
    </section>
  ))}

  <style>
    h1 {
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 28px;
      margin-bottom: 0;
    }
    h1::after {
      content: '';
      display: block;
      width: 60%;
      max-width: 280px;
      height: 3px;
      background: var(--accent);
      margin: 8px auto 0;
    }
    h2 {
      font-size: 22px;
      color: var(--accent-dark);
      border: none;
      padding: 0;
      margin: 36px 0 8px;
    }
    .year-section { margin-top: 32px; }
    .year-header {
      font-size: 20px;
      font-weight: 600;
      color: var(--ink);
      border-bottom: 2px solid var(--line);
      padding-bottom: 8px;
      margin-bottom: 16px;
    }
    .pub { margin: 0 0 18px; }
    .pub-title {
      display: block;
      color: var(--accent);
      font-weight: 500;
      text-decoration: none;
      font-size: 16px;
      margin-bottom: 4px;
      line-height: 1.4;
    }
    .pub-title:hover { text-decoration: underline; }
    .pub-cite {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
    }
    .pub-cite a {
      color: var(--accent);
      word-break: break-all;
    }
  </style>
</Base>
